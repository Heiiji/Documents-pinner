{
  "name": "documents-pinner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Foundry VTT module: pin a document onto the map as a pin or a readable prop, with per-pin visibility and immersive effects.",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,mts,js}\" \"styles/**/*.css\"",
    "harness": "vite-node scripts/build-harness.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "parse5": "^8.0.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vite-node": "^3.2.4",
    "vitest": "^5.0.3"
  }
}
